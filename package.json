{
  "name": "refatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RefAtlas 只读原始配置访问工作台",
  "author": "RefAtlas contributors",
  "license": "MIT",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,js,svelte,html,css}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.mjs\" \"messages/*.json\" project.inlang/settings.json i18n.config.ts package.json electron.vite.config.ts electron-builder.yml vitest.config.ts svelte.config.js tsconfig.json tsconfig.renderer.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,html,css}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.mjs\" \"messages/*.json\" project.inlang/settings.json i18n.config.ts package.json electron.vite.config.ts electron-builder.yml vitest.config.ts svelte.config.js tsconfig.json tsconfig.renderer.json .prettierrc.json",
    "validate:foundation": "node scripts/validate.mjs",
    "i18n:prepare": "node scripts/i18n-prepare.mjs",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "predev": "npm run i18n:compile",
    "pretypecheck": "npm run i18n:compile",
    "pretest": "npm run i18n:compile",
    "pretest:raw-data": "npm run i18n:compile",
    "prebuild": "npm run i18n:compile",
    "presmoke:dev": "npm run i18n:compile",
    "dev": "electron-vite dev",
    "install:electron": "node scripts/install-electron.mjs",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.renderer.json",
    "test": "vitest run",
    "test:raw-data": "node scripts/raw-real-data.mjs",
    "build": "electron-vite build",
    "smoke:built": "node scripts/smoke.mjs built",
    "smoke:dev": "node scripts/smoke.mjs dev",
    "package:win:x64": "node scripts/package.mjs win32 x64",
    "package:mac:arm64": "node scripts/package.mjs darwin arm64",
    "smoke:packaged": "node scripts/smoke.mjs packaged",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "@tanstack/svelte-virtual": "3.13.39",
    "@zag-js/svelte": "1.44.0",
    "@zag-js/tree-view": "1.44.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
